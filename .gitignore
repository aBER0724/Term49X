# build outputs
Device-Debug/
Device-Release/
*.bar
*.o
*.a
*.so
SDL/build/
terminfo-stage.tar
.zsh-build/

# signing material — never commit
signing/bbpass
signing/*.csk
signing/*.bar
signing/*.p12
signing/ssh-key*

# Vendored runtime assets are tracked on purpose, so a fresh clone builds and
# packages without re-vendoring: prebuilt SDL / TCO / libconfig (*.so), the two
# fonts (*.ttf), share/xiaohe.dict, the bundled zsh and the ssh tools.
# Upstream Term49C dropped these to slim its history; see docs/INSTALL.md.
!external/lib/*.so
!external/fonts/*.ttf
!share/root/bin/*
!share/root/libexec/*
